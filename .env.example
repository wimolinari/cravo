# Copie para .env e preencha com suas chaves reais (NÃO comite o .env).

# Anthropic — usado pelo chatbot
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (opcional, para outros usos do projeto)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# SQL Server (opcional, para outros usos)
SQL_SERVER=
SQL_DATABASE=
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUST_SERVER_CERTIFICATE=yes
